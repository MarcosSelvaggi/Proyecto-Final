<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="Fixnet.MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Fixnet</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
    <link rel="stylesheet" href="styles/StylesMasterPage.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://cdn.lineicons.com/5.1/line/lineicons.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <header>
                <nav class="navbar fixed-top navbar-expand-lg navbar-light bg-light">

                    <a class="navbar-brand mb-0" href="/Default.aspx">
                        <img src="assets/logo.png" alt="Logo" id="brand-logo">
                    </a>

                    <!-- Botón hamburguesa -->
                    <button class="navbar-toggler ms-auto me-3" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false"
                        aria-label="Boton menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">

                        <!-- Menú central -->
                        <ul class="navbar-nav mx-auto text-center text-lg-start">
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="#hero">Publica tus servicios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="#services">Buscar profesionales</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="#about-us">Sobre Fixnet</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="#contact">Contáctanos</a>
                            </li>
                        </ul>

                        <!-- Menú derecho -->
                        <ul class="navbar-nav ms-lg-auto me-3 text-center text-lg-start">
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="/Registro.aspx">Registrarse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active hover-underline" href="/Logearse.aspx">Iniciar sesión</a>
                            </li>
                        </ul>

                    </div>

                </nav>
            </header>

        </div>
        <div id="content" style="margin-top: 100px">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer id="footer-copyright">
            <div class="container-fluid px-5">
                <p class="footer-information">Copyright © Fixnet 2026 | Grupo 3 | FRGP</p>
            </div>
        </footer>
    </form>
</body>
</html>
